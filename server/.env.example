# ==========================================
# DenHub Server - Environment Variables Template
# Sao chep file nay thanh .env
# ==========================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (SQL Server)
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=denhubdb;encrypt=false;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=your_password_here

# JWT Security Configuration
JWT_BASE64_SECRET=your_base64_secret_key_here
JWT_ACCESS_TOKEN_VALIDITY=86400
JWT_REFRESH_TOKEN_VALIDITY=604800

# Client Application URL
CLIENT_BASE_URL=http://localhost:5173
CLIENT_ALLOW_LOCALHOST=true
